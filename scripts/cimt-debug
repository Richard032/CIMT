#!/bin/bash
set -euo pipefail

source_root="$(cd "$(dirname "$0")/.." && pwd)"
export CIMT_INSTALL_ROOT="${CIMT_INSTALL_ROOT:-$HOME/Development/CIMT/.local/install}"
source "$CIMT_INSTALL_ROOT/environment.sh"

case "${CIMT_DEBUG_PYTHON:-execution}" in
  execution|preflight|proposal|off) ;;
  *) echo "CIMT_DEBUG_PYTHON must be execution, preflight, proposal, or off." >&2; exit 3 ;;
esac
export CIMT_DEBUG_PYTHON="${CIMT_DEBUG_PYTHON:-execution}"

if [ "$CIMT_DEBUG_PYTHON" != off ] && [ -z "${CIMT_DEBUGPY_PATH:-}" ]; then
  # Use the debugger bundled with VS Code's Python Debugger extension.
  for libs in "$HOME"/.vscode/extensions/ms-python.debugpy-*/bundled/libs; do
    if [ -d "$libs/debugpy" ]; then CIMT_DEBUGPY_PATH="$libs"; fi
  done
  if [ -z "${CIMT_DEBUGPY_PATH:-}" ]; then
    echo "Install the VS Code Python Debugger extension or set CIMT_DEBUGPY_PATH to the folder containing debugpy." >&2
    exit 3
  fi
fi
export CIMT_DEBUGPY_PATH

(cd "$source_root" && dotnet build src/Cimt/Cimt.csproj -c Debug)
export CIMT_DEBUG_RUNTIME="$source_root/runtime"
export CIMT_WAIT_FOR_DEBUGGER=1
exec "$source_root/src/Cimt/bin/Debug/net10.0/cimt" "$@"
