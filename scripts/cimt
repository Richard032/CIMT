#!/bin/bash
set -euo pipefail
CIMT_SOURCE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [ -z "${CIMT_INSTALL_ROOT:-}" ]; then
  if [ -f "$CIMT_SOURCE_ROOT/lib/cimt/cimt.dll" ]; then
    export CIMT_INSTALL_ROOT="$CIMT_SOURCE_ROOT"
  elif [ -f "$CIMT_SOURCE_ROOT/.local/install/environment.sh" ]; then
    export CIMT_INSTALL_ROOT="$CIMT_SOURCE_ROOT/.local/install"
  else
    export CIMT_INSTALL_ROOT=/Users/Shared/CIMT
  fi
fi
if [ -f "$CIMT_INSTALL_ROOT/environment.sh" ]; then source "$CIMT_INSTALL_ROOT/environment.sh"; fi
if [ -f "$CIMT_SOURCE_ROOT/lib/cimt/cimt.dll" ]; then
  exec dotnet "$CIMT_SOURCE_ROOT/lib/cimt/cimt.dll" "$@"
fi
exec dotnet "$CIMT_SOURCE_ROOT/src/Cimt/bin/Release/net10.0/cimt.dll" "$@"
