{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${userHome}/Development/CIMT/.local/install/tools/python/bin/python"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build CIMT Debug",
        "type": "process",
        "command": "/usr/local/share/dotnet/dotnet",
        "args": [
          "build",
          "src/Cimt/Cimt.csproj",
          "-c",
          "Debug"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": "$msCompile"
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "CIMT host · show help",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "Build CIMT Debug",
        "program": "${workspaceFolder}/src/Cimt/bin/Debug/net10.0/cimt.dll",
        "args": [
          "--help"
        ],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "env": {
          "CIMT_INSTALL_ROOT": "${userHome}/Development/CIMT/.local/install"
        }
      },
      {
        "name": "Python runtime · knowledge tests",
        "type": "debugpy",
        "request": "launch",
        "module": "unittest",
        "args": [
          "discover",
          "-s",
          "tests",
          "-p",
          "test_knowledge.py"
        ],
        "python": "${userHome}/Development/CIMT/.local/install/tools/python/bin/python",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "ms-dotnettools.csharp",
      "ms-python.python",
      "ms-python.debugpy"
    ]
  }
}
